// ---------- Sequence settings ----------
const unsigned long TEXT_HOLD_MS = 600;  // how long each text frame stays on screen
const unsigned long EYES_MS      = 50;   // your original eye frame speed
const uint8_t       EYES_LOOPS   = 3;    // how many times the eye animation plays

enum Phase { PH_INTRO, PH_EYES, PH_NAME, PH_YOUARE };
Phase phase = PH_INTRO;
uint8_t idx = 0;
uint8_t eyeLoop = 0;

// Draw 1 or 2 lines of text centered on screen
void drawCentered(const char* l1, const char* l2, uint8_t sx, uint8_t sy, bool invert = false) {
  display.clearDisplay();
  if (invert) display.fillRect(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, SSD1306_WHITE);
  display.setTextColor(invert ? SSD1306_BLACK : SSD1306_WHITE);
  display.setTextSize(sx, sy);
  display.setTextWrap(false);

  int16_t x1, y1; uint16_t w, h;
  display.getTextBounds(l1, 0, 0, &x1, &y1, &w, &h);
  uint8_t lines = l2 ? 2 : 1;
  int16_t gap = 4;
  int16_t totalH = lines * h + (lines - 1) * gap;
  int16_t top = (SCREEN_HEIGHT - totalH) / 2;

  display.setCursor((SCREEN_WIDTH - w) / 2 - x1, top - y1);
  display.print(l1);

  if (l2) {
    display.getTextBounds(l2, 0, 0, &x1, &y1, &w, &h);
    display.setCursor((SCREEN_WIDTH - w) / 2 - x1, top + h + gap - y1);
    display.print(l2);
  }
  display.display();
}

void setup() {
  Serial.begin(115200);
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDR)) {
    Serial.println(F("SSD1306 allocation failed"));
    for (;;);
  }
  display.setRotation(0);
  display.clearDisplay();
  display.display();
}

void loop() {
  static unsigned long lastMs = 0;
  static unsigned long interval = 0;   // how long the last-drawn frame should stay

  const uint8_t* frames[] = {frame0, frame1, frame2, frame3, frame4, frame5, frame6, frame7,
                             frame8, frame9, frame10, frame11, frame12, frame13, frame14,
                             frame15, frame16, frame17, frame18, frame19};
  const uint8_t numFrames = 20;

  if (millis() - lastMs < interval) return;
  lastMs = millis();

  switch (phase) {

    // 4 frames: "Who is Topper?" typing in
    case PH_INTRO:
      if      (idx == 0) drawCentered("Who", nullptr, 3, 3);
      else if (idx == 1) drawCentered("Who is", nullptr, 2, 3);
      else if (idx == 2) drawCentered("Who is", "Topper", 2, 2);
      else               drawCentered("Who is", "Topper?", 2, 2);
      interval = TEXT_HOLD_MS;
      if (++idx >= 4) { idx = 0; phase = PH_EYES; eyeLoop = 0; }
      break;

    // Your eye animation (20 frames)
    case PH_EYES:
      display.clearDisplay();
      display.drawBitmap(0, 0, frames[idx], 128, 64, SSD1306_WHITE);
      display.display();
      interval = EYES_MS;
      if (++idx >= numFrames) {
        idx = 0;
        if (++eyeLoop >= EYES_LOOPS) { eyeLoop = 0; phase = PH_NAME; }
      }
      break;

    // 2 frames: "NAME !" full screen (normal, then inverted flash)
    case PH_NAME:
      drawCentered("NAME!", nullptr, 2, 4, idx == 1);
      interval = TEXT_HOLD_MS;
      if (++idx >= 2) { idx = 0; phase = PH_YOUARE; }
      break;

    // 3 frames: "You Are !"
    case PH_YOUARE:
      if      (idx == 0) drawCentered("You", nullptr, 3, 3);
      else if (idx == 1) drawCentered("You Are", nullptr, 2, 3);
      else               drawCentered("You Are !", nullptr, 2, 3);
      interval = TEXT_HOLD_MS;
      if (++idx >= 3) { idx = 0; phase = PH_INTRO; }  // loops back to the start
      break;
  }
}
